# =============================================================================
# n8n Environment Variables — copy to .env and fill in real values
# =============================================================================
# NEVER commit your real .env file.
# =============================================================================

# ── n8n Core ─────────────────────────────────────────────────────────────
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_ENCRYPTION_KEY=CHANGE-ME-to-a-long-random-string

# Public URL for webhooks (set to your EC2/domain URL in production)
WEBHOOK_URL=http://localhost:5678/

# Timezone (IANA format)
GENERIC_TIMEZONE=America/Los_Angeles

# ── PostgreSQL ───────────────────────────────────────────────────────────
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=super-secret-change-me

# ── Custom API Keys (read in workflows via {{$env.VAR}}) ─────────────────
N8N_API_KEY=your-custom-key-for-workflows
MY_SERVICE_TOKEN=
