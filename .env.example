# =============================================================================
# Lab Environment Variables — copy to .env and fill in real values
# =============================================================================
# NEVER commit the real .env file — it is gitignored.
# =============================================================================

# AWS (set after running: aws configure --profile lab)
AWS_PROFILE=lab
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>
AWS_REGION=us-east-1
S3_BUCKET=highlander-events-media

# GitHub Personal Access Token
GITHUB_TOKEN=<your-github-token>

# n8n automation
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=<your-n8n-api-key>

# PostgreSQL (Railway)
DATABASE_URL=postgresql://postgres:<password>@<host>:<port>/railway

# OpenAI
OPENAI_API_KEY=<your-openai-api-key>

# Anthropic
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Figma
FIGMA_TOKEN=<your-figma-token>

# Semantic Scholar
S2_API_KEY=<your-s2-api-key>

# IBM Quantum
IBM_QUANTUM_TOKEN=<your-ibm-quantum-token>

# Dynatrace
DYNATRACE_API_TOKEN=<your-dynatrace-api-token>
DYNATRACE_ENV_URL=https://<your-env-id>.live.dynatrace.com

# Harness
HARNESS_API_KEY=<your-harness-api-key>

# HuggingFace
HF_TOKEN=<your-huggingface-token>

# Slack Bot
SLACK_BOT_TOKEN=<your-slack-bot-token>

# Expo (set when you create an Expo account)
EXPO_TOKEN=<your-expo-token>

# App
JWT_SECRET=<your-strong-random-secret>
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
